TxScript GetRawOraclePrice(oracle: IDIAOracle, key: ByteVec) {
    pub fn main() -> U256 {
        let (price, _) = oracle.getValue(key)
        return price
    }
}

TxScript GetRawOraclePriceWithTimestamp(oracle: IDIAOracle, key: ByteVec) {
    pub fn main() -> (U256, U256) {
        return oracle.getValue(key)
    }
}